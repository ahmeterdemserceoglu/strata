# ==============================================================================
# STRATA PLATFORMU — ORTAM DEĞİŞKENLERİ (.env.example)
# Her değişkenin kullanım amacı ve nereden temin edileceği açıklanmıştır.
# Yerelde otomatik üretim için: `pnpm setup:dev` komutunu çalıştırın.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TEMEL SUNUCU VE ÇALIŞMA AYARLARI
# ------------------------------------------------------------------------------
# Çalışma modu: 'development' veya 'production'
NODE_ENV=development
# API sunucusu HTTP dinleme portu
API_PORT=4000
# API sunucusu host adresi
API_HOST=0.0.0.0
# WebSocket Gateway dinleme portu
GATEWAY_PORT=4001
# Dışarıya açık API adresi (istemcilerin ve OAuth dönüşlerinin kullanacağı URL)
API_PUBLIC_URL=http://localhost:4000
# Dışarıya açık WebSocket Gateway URL'si (istemcilerin bağlanacağı ws/wss adresi)
GATEWAY_PUBLIC_URL=ws://localhost:4001
# Web istemcisi URL'si (CORS ve yönlendirmeler için)
WEB_PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. VERİTABANLARI VE CACHE
# ------------------------------------------------------------------------------
# PostgreSQL bağlantı URL'si (PgBouncer üzerinden veya doğrudan postgres)
DATABASE_URL=postgresql://strata:strata_dev_password@localhost:5432/strata_db?sslmode=disable
# Redis bağlantı URL'si (Redis Cluster veya dev ortamında tek düğüm)
REDIS_URL=redis://localhost:6379
# ScyllaDB bağlantı adresleri (virgülle ayrılmış IP veya host adları)
SCYLLA_CONTACT_POINTS=127.0.0.1
# ScyllaDB yerel datacenter adı
SCYLLA_LOCAL_DC=datacenter1
# ScyllaDB keyspace adı
SCYLLA_KEYSPACE=strata_messages

# ------------------------------------------------------------------------------
# 3. GÜVENLİK VE KİMLİK DOĞRULAMA (KRİPTOGRAFİ)
# ------------------------------------------------------------------------------
# Ed25519 JWT İmzalama Özel Anahtarı (PEM formatında) - `pnpm setup:dev` ile otomatik üretilir
JWT_PRIVATE_KEY=""
# Ed25519 JWT Doğrulama Açık Anahtarı (PEM formatında) - `pnpm setup:dev` ile otomatik üretilir
JWT_PUBLIC_KEY=""
# JWT Key ID (JWKS anahtar rotasyonu için)
JWT_KID=strata-dev-key-1
# MFA (TOTP) Secret Şifreleme Anahtarı (32 byte hex, AES-256-GCM) - `pnpm setup:dev` ile üretilir
MFA_ENCRYPTION_KEY=""
# Access Token Geçerlilik Süresi (dakika cinsinden, varsayılan: 15)
ACCESS_TOKEN_EXPIRES_MINUTES=15
# Refresh Token Geçerlilik Süresi (gün cinsinden, varsayılan: 30)
REFRESH_TOKEN_EXPIRES_DAYS=30

# ------------------------------------------------------------------------------
# 4. OAUTH2 SAĞLAYICILARI (OPSİYONEL - DEĞERLER BOŞSA GİRİŞ BUTONU GİZLENİR)
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. MEDYA VE SES (LIVEKIT SFU)
# ------------------------------------------------------------------------------
# LiveKit sunucu WebSocket adresi
LIVEKIT_URL=ws://localhost:7880
# LiveKit API Key (dev için 'devkey' veya `pnpm setup:dev` ile üretilen)
LIVEKIT_API_KEY=devkey
# LiveKit API Secret (dev için 'secret' veya `pnpm setup:dev` ile üretilen)
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# 6. NESNE DEPOLAMA (S3 / MINIO) VE GÖRSEL PROXY
# ------------------------------------------------------------------------------
# S3 veya MinIO HTTP endpoint'i (geliştirmede MinIO)
S3_ENDPOINT=http://localhost:9000
# S3 bölgesi (MinIO için 'us-east-1' yeterlidir)
S3_REGION=us-east-1
# S3 Bucket adı
S3_BUCKET=strata-attachments
# S3 Erişim Anahtarı (MinIO kök kullanıcısı)
S3_ACCESS_KEY=minioadmin
# S3 Gizli Anahtarı (MinIO şifresi)
S3_SECRET_KEY=minioadmin
# Yüklenen dosyaların dışarıdan okunacağı genel URL (CDN veya S3 URL)
S3_PUBLIC_URL=http://localhost:9000/strata-attachments
# imgproxy sunucu URL'si (küçük resim ve avatar boyutlandırma)
IMGPROXY_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 7. ARAMA VE E-POSTA
# ------------------------------------------------------------------------------
# Meilisearch ana makine URL'si
MEILISEARCH_HOST=http://localhost:7700
# Meilisearch API Master Key
MEILISEARCH_KEY=strata_master_search_key
# E-posta SMTP Sunucusu (Geliştirmede Mailpit kullanılır: port 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
# Giden e-postaların 'Kimden' adresi
EMAIL_FROM=Strata Platform <no-reply@strata.chat>

# ------------------------------------------------------------------------------
# 8. İZLEME VE GÖZLEMLENEBİLİRLİK (OPSİYONEL)
# ------------------------------------------------------------------------------
# Sentry DSN (Tanımlanmazsa Sentry otomatik olarak devre dışı kalır)
SENTRY_DSN=""
# Cloudflare Turnstile Bot Koruması (Tanımlanmazsa bot challenge atlanır)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
